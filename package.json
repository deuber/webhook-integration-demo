{
  "name": "webhook-integration-demo",
  "version": "1.0.0",
  "description": "GitHub webhook receiver demonstrating REST, GraphQL, OAuth 2.0, and webhook signature/idempotency handling",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "simulate": "tsx scripts/simulate-webhook.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
