PORT=3000

# Shared secret used to verify the X-Hub-Signature-256 header on incoming
# webhook deliveries. Set this to whatever secret you configure on the
# GitHub webhook itself.
WEBHOOK_SECRET=demo-webhook-secret-change-me

# Optional. With this set, the REST and GraphQL follow-up calls hit the real
# GitHub API instead of just logging what they would send (dry-run mode).
# Use a fine-grained personal access token scoped to a throwaway test repo.
GITHUB_TOKEN=

# Optional. Register a free GitHub OAuth App (Settings -> Developer settings
# -> OAuth Apps) to try the live /auth/login -> /auth/callback flow.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
